<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- кроссплатформенные таргеты: библиотеку можно использовать и в старых сервисах, и в .NET 8 -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- чтобы артефакты разных TFM не затирали друг друга -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>

    <!-- никаких UseWindowsForms / UseWPF / ImportWindowsDesktopTargets -->
  </PropertyGroup>

  <!-- если ты вызываешь antlr-jar во время работы, кладём его рядом с бинарями -->
  <ItemGroup>
    <Content Include="Resources\antlr-4.7-complete.jar">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- ANTLR runtime: netstandard2.0, работает в .NET 8 -->

    <!-- Roslyn для компиляции кода на лету (вместо CodeDOM) -->
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.7.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />

    <!-- если не используешь Newtonsoft.Json — строку ниже удали -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Springcomp.GPPG.Runtime" Version="1.2.4" />
  </ItemGroup>

</Project>
