NON_COMMENT	: '\\/' | '\\(' | '\\)'
COMMENT		: COMMENT_L|COMMENT_ML
COMMENT_L	: '//' ~[\n\r]*
COMMENT_ML	: '/*' .*? '*/'




STRING		: '"' (~["]|'""')* '"'
STRING_Q	: '`' .*? '`'

CHAR		: '\'' ('\\\''|'\\\\'|.)*? '\''

NEW: 'new'
BOOL: 'true' | 'false'

MODIFICATOR: 'async' | 'public' | 'protected' | 'readonly' | 'private' | 'abstract'

ID			: [_a-zA-Z\u0430-\u044F\u0410-\u042F\u0192\u06F0\u03A9][_0-9a-zA-Z\u0430-\u044F\u0410-\u042F.\u0192\u06F0\u03A9]*


LB			: '('
RB			: ')'
EXM			: '!'
 
CURVE_BRACKETED : %left '{' %right '}'
ROUND_BRACKETED : %left '(' %right ')'
SQUARE_BRACKETED : %left ('['|GENERAL_ATTRIBUTE_START) %right ']'


DEC			: '-'?[0-9]+('.'[0-9]+)*

COMMA 		: ','
COLON		: ':'





content = entity*

entity	= water_entity | resolver_section | class | lamda_struct

// class section
class = 'class' ID template? (('extends'|'implements') Any)? '{' (func|field)* '}'

field = MODIFICATOR* ID '?'? (':'|'=') Any ';'

func = MODIFICATOR* ID '?'? '(' Any ')' return_type? '{' Any '}'

// lambda struct section
lamda_struct = 'const' ID '=' '(' Any ')' (':' ID)? '=>' AnyAvoid(NEW, 'class') ( '(' resolver_blocks ')' | '{' Any '}' )


// struct section
resolver_section = 'const' ID  '=' resolver_blocks | 'const' ID (':' ID)?  '=' resolver_blocks

resolver_blocks = '{' (resolver_block ',')* resolver_block? '}'
resolver_block = ID ':' '{' (resolver_line ',')* resolver_line? '}'
resolver_line = resolver_line_impl  | resolver_line_obj | resolver_line_var| resolver_line_literal

resolver_line_impl = ID ':' '(' Any ')' (':' ID)? '=>' 
	(
		Any
		|'{' Any '}'
	)
	
resolver_line_obj = ID ':' '{' Any '}' // to be ignored
resolver_line_var = ID ':' Any
resolver_line_literal = ID ':' BOOL // to be ignored

template = ('<' (Any|','|'<'|'>')* '>')
array = '[' (Any|array)* ']'
return_type = ':' ID template? array?


water_entity	=	Any 

%%

%parsing {
	recovery entity 
	fragment STRING_INT_CODE
	start content
	skip COMMENT STRING DEC CHAR STRING_Q BOOL
}

%nodes {
	ghost entity
	leaf 
	void LB RB COMMA COLON MODIFICATOR
}



%markup {
	land func_line type_def type_line
	headercore(id) func_line type_def
}
