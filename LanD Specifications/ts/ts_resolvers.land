NON_COMMENT	: '\\/' | '\\(' | '\\)'
COMMENT		: COMMENT_L|COMMENT_ML
COMMENT_L	: '//' ~[\n\r]*
COMMENT_ML	: '/*' .*? '*/'




STRING		: '"' (~["]|'""')* '"'
STRING_Q	: '`' .*? '`'

CHAR		: '\'' ('\\\''|'\\\\'|.)*? '\''

NEW: 'new'
BOOL: 'true' | 'false'

MODIFICATOR: 'async' | 'public' | 'protected' | 'readonly' | 'private' | 'abstract' | 'static'

ID			: [_a-zA-Z\u0430-\u044F\u0410-\u042F\u0192\u06F0\u03A9][_0-9a-zA-Z\u0430-\u044F\u0410-\u042F.\u0192\u06F0\u03A9]*


LB			: '('
RB			: ')'
EXM			: '!'
 
CURVE_BRACKETED : %left '{' %right '}'
ROUND_BRACKETED : %left '(' %right ')'
SQUARE_BRACKETED : %left ('['|GENERAL_ATTRIBUTE_START) %right ']'


DEC			: '-'?[0-9]+('.'[0-9]+)*

COMMA 		: ','
COLON		: ':'





content = entity*

entity	= water_entity | struct | class | lamda_struct

// class section
class = 'class' ID template? (('extends'|'implements') Any)? '{' (func|field|decorator)* '}'

field = MODIFICATOR* ID '?'? (':'|'=') Any ';'

func = MODIFICATOR* ID '?'? '(' Any ')' return_type? '{' Any '}'

// lambda struct section
lamda_struct = 'const' ID '=' '(' Any ')' return_type? '=>' AnyAvoid(NEW, 'class') ( '(' struct_blocks ')' | '{' Any '}' )


// struct section
struct = 'const' ID  '=' struct_blocks | 'const' ID return_type?  '=' struct_blocks

struct_blocks = '{' (struct_block ',')* struct_block? '}'

struct_block = field_block | field_any
field_block = ID ':' '{' (sub_field ',')* sub_field? '}'
field_any = ID ':' Any


sub_field = sub_field_func_impl | sub_field_obj | sub_field_any| sub_field_literal | sub_field_arr

sub_field_func_impl = ID ':' '(' Any ')' (':' ID)? '=>' 
	(
		Any
		|'{' Any '}'
	)

sub_field_any = ID ':' Any
sub_field_obj = ID ':' '{' Any '}' // to be ignored
sub_field_arr = ID ':' Any '[' Any ']' // to be ignored
sub_field_literal = ID ':' (BOOL|CHAR|DEC|STRING|STRING_Q) // to be ignored

// helpers
template = ('<' (Any|','|'<'|'>')* '>')
array = '[' (Any|array)* ']'
return_type = ':' ID template? array? ('|' ID)?

decorator = '@' Any '(' Any ')'


water_entity	=	Any 

%%

%parsing {
	recovery entity 
	fragment STRING_INT_CODE
	start content
	skip COMMENT STRING DEC CHAR STRING_Q BOOL
}

%nodes {
	ghost entity
	leaf 
	void LB RB COMMA COLON MODIFICATOR
}



%markup {
	land func_line type_def type_line
	headercore(id) func_line type_def
}
