COMMENT		: COMMENT_L|COMMENT_ML
COMMENT_L	: '#' ~[\n\r]*
COMMENT_ML	: '"""' .*? '"""'



STRING		: '"' (~["]|'""')* '"'

ID			: [_a-zA-Z\u0430-\u044F\u0410-\u042F\u0192\u06F0\u03A9][_0-9a-zA-Z\u0430-\u044F\u0410-\u042F.\u0192\u06F0\u03A9]*


LB			: '('
RB			: ')'
LSB			: '['
RSB			: ']'
EXM			: '!'
 
CURVE_BRACKETED : %left '{' %right '}'
ROUND_BRACKETED : %left '(' %right ')'
SQUARE_BRACKETED : %left ('['|GENERAL_ATTRIBUTE_START) %right ']'


DEC			: '-'?[0-9]+('.'[0-9]+)*

COMMA 		: ','
COLON		: ':'



content = entity*

entity	= water_entity | resolver_section

resolver_section = 'const' ID '=' '{' resolver_block* '}'
resolver_block = ID ':' '{' resolver_line* '}' ','
resolver_line = ID ':' '(' Any ')' (':' ID)? '=>' 
	(
		Any
		|'{' Any '}'
	) ',' 
	


//type_def =  'extend'? ('type'|'input'|'interface') id Any ('{' (type_line|func_line)* '}')? 
//type_line = id COLON type default_value? tag* ','?
//type = id  | '[' type? ']' | type '!'

//value = id | DEC | STRING | '[' (Any|value)* ']' | '{' (Any|value)*'}'
//default_value = '=' value

//func_line = id '(' func_arg* ')' COLON type tag* ','? 
//func_arg = type_line
//tag = '@' id ('(' Any ')')? ','?


//id = ID | 'type' | 'input' | 'interface' // to allow considering keywords as a var name 


water_entity	=	Any 


%%

%parsing {
	recovery entity 
	fragment STRING_INT_CODE
	start content
	skip COMMENT STRING DEC
}

%nodes {
	ghost entity
	leaf 
	void LB RB COMMA COLON 
}

%customblock {
	start("//+")
	end("//@")
	basetoken COMMENT
}

%markup {
	land func_line type_def type_line
	headercore(id) func_line type_def
}
