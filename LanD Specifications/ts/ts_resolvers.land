NON_COMMENT	: '\\/' | '\\(' | '\\)'
COMMENT		: COMMENT_L|COMMENT_ML
COMMENT_L	: '//' ~[\n\r]*
COMMENT_ML	: '/*' .*? '*/'

SPREAD : '...'

NL: '\n'

STRING		: '"' (~["]|'""')* '"'
STRING_Q	: '`' .*? '`'

CHAR		: '\'' ('\\\''|'\\\\'|.)*? '\''

NEW: 'new'
BOOL: 'true' | 'false'
ASYNC: 'async'

//MODIFICATOR: 'async' | 'public' | 'protected' | 'readonly' | 'private' | 'abstract' | 'static' | 'override'

ID			: [_a-zA-Z\u0430-\u044F\u0410-\u042F\u0192\u06F0\u03A9][_0-9a-zA-Z\u0430-\u044F\u0410-\u042F.\u0192\u06F0\u03A9]*


LB			: '('
RB			: ')'
EXM			: '!'
 
CURVE_BRACKETED : %left '{' %right '}'
ROUND_BRACKETED : %left '(' %right ')'
SQUARE_BRACKETED : %left ('['|GENERAL_ATTRIBUTE_START) %right ']'


DEC			: '-'?[0-9]+('.'[0-9]+)*

COMMA 		: ','
COLON		: ':'





content = entity*

entity	= water_entity | struct | class | lamda_struct

// class section
class = 'class' ID template? (('extends'|'implements') Any)? '{' (func|Any)* '}'



func = ID+ template? '?'? '!'? '(' Any ')' func_return_type? '{' Any '}'

// lambda struct section
lamda_struct = 'const' ID '=' template? '(' Any ')' return_type? '=>' AnyAvoid(NEW, 'class') ( '(' struct_blocks ')' | '{' Any '}' )


// struct section
struct = 'const' ID  '=' struct_blocks | 'const' ID return_type?  '=' struct_blocks

struct_blocks = '{' (struct_block ',')* struct_block? '}'

struct_block = field_block | field_any | field_just | field_spread
field_block = ID ':' '{' (sub_field ',')* sub_field? '}'
field_any = ID ':' Any
field_just = ID
field_spread = SPREAD ID


sub_field = sub_field_func_impl | sub_field_obj | sub_field_any| sub_field_call| sub_field_id|sub_field_literal | sub_field_arr|sub_field_just | sub_field_cond

sub_field_func_impl = ID ':' ASYNC? '(' Any ')' (':' ID)? '=>' 
	(
		Any
		|'{' Any '}'
	)

sub_field_cond = ID ':' Any '?' Any ':' Any
sub_field_any = ID ':' Any
sub_field_id = ID ':' ID array?
sub_field_call = ID ':' ID template? '(' Any ')'
sub_field_just = ID 
sub_field_obj = ID ':' '{' Any '}' // to be ignored
sub_field_arr = ID ':' Any '[' Any ']' // to be ignored
sub_field_literal = ID ':' (BOOL|CHAR|DEC|STRING|STRING_Q) // to be ignored

// helpers
template = '<' (Any|template)* '>'
array = '[' (Any|array)* ']'
return_type = ':' ID template? array? ('|' ID)?
			| ':' '{' Any '}'
			
func_return_type = ':' ((AnyAvoid(';')|template)* | '{' Any '}')

decorator = '@' Any '(' Any ')'


water_entity	=	Any 

%%

%parsing {
	recovery 
	fragment STRING_INT_CODE
	start content
	skip COMMENT STRING DEC STRING_Q BOOL NL ASYNC
}

%nodes {
	ghost entity
	leaf 
	void LB RB COMMA COLON
}



%markup {
	land func_line type_def type_line
	headercore(id) func_line type_def
}
