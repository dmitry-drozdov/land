

LTB : '<'
RTB	: '>'

TRIANGLE: %left_manual '<' %right_manual '>'




content =  template

template =  ('<' 'X' Any 'X' '>') | (%'<' (Any|template)* %'>') 


%%

%parsing {
	recovery 
	fragment
	start content
	skip
}

%nodes {
	ghost
	leaf 
	void
}



%markup {
	land func_line type_def type_line
	headercore(id) func_line type_def
}
